{
  "expo": {
    "name": "Tribbu",
    "slug": "tribbu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tribbu.familia"
    },
    "android": {
      "package": "app.tribbu.familia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E2A4F"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Tribbu usa tus fotos para adjuntar imágenes a recetas y documentos."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#141B33"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
